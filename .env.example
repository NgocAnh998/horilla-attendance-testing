# Copy this file to .env. Never put passwords or tokens in this example.
# BASE_URL should point to the Horilla instance under test.
BASE_URL=https://hr.demo.horilla.com
PLAYWRIGHT_STORAGE_STATE=playwright/.auth/user.json

# Safe defaults. Enable mutations only for a dedicated test account/company.
RUN_ATTENDANCE_MUTATIONS=false
ATTENDANCE_ALLOW_CLOCK_ACTIONS=false

# Optional behavior settings; these match the defaults in attendance.spec.js.
ATTENDANCE_REQUEST_DECISION=approve
ATTENDANCE_EXPECT_POLICY_ACCESS=true
ATTENDANCE_SEARCH_KEYWORD=
ATTENDANCE_EMPLOYEE_FILTER=
ATTENDANCE_MONTHLY_EXPECTED_PRESENT=
ATTENDANCE_MONTHLY_EXPECTED_HOURS=

# Fill fixture values only after the corresponding real records are visible in Horilla.
# Record text should be a unique substring from the actual row, not invented test data.
ATTENDANCE_EMPLOYEE_NAME=
ATTENDANCE_OTHER_EMPLOYEE_NAME=
ATTENDANCE_OVERNIGHT_RECORD_TEXT=
ATTENDANCE_PENDING_RECORD_TEXT=
ATTENDANCE_OT_RECORD_TEXT=
ATTENDANCE_REQUEST_RECORD_TEXT=
ATTENDANCE_REQUEST_DATE=
ATTENDANCE_REQUEST_CHECK_IN=
ATTENDANCE_REQUEST_CHECK_OUT=
ATTENDANCE_CORRECTION_RECORD_TEXT=
ATTENDANCE_CORRECTION_CHECK_IN=
ATTENDANCE_CORRECTION_CHECK_OUT=
ATTENDANCE_DAILY_STATUS_FIXTURE=
ATTENDANCE_CLOCK_TEST_USER=
ATTENDANCE_DUPLICATE_ACTION=
ATTENDANCE_LATE_RECORD_TEXT=
ATTENDANCE_EARLY_RECORD_TEXT=
ATTENDANCE_NEW_POLICY_NAME=
ATTENDANCE_POLICY_NAME=
ATTENDANCE_POLICY_BOUNDARY_LABEL=
ATTENDANCE_POLICY_INVALID_VALUE=
ATTENDANCE_POLICY_VALID_VALUE=

# Current Horilla demo session role; Employee-only tests skip on this Admin-only demo.
ATTENDANCE_SESSION_ROLE=admin
