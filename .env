BASE_URL=https://hr.demo.horilla.com/
RUN_ATTENDANCE_MUTATIONS=true
ATTENDANCE_ALLOW_CLOCK_ACTIONS=true
# Local Playwright state selection. Keep authentication state files out of Git.
PLAYWRIGHT_STORAGE_STATE=playwright/.auth/user.json

# Optional behavior defaults used by attendance.spec.js.
ATTENDANCE_REQUEST_DECISION=approve
ATTENDANCE_EXPECT_POLICY_ACCESS=true
ATTENDANCE_SEARCH_KEYWORD=
ATTENDANCE_EMPLOYEE_FILTER=
ATTENDANCE_MONTHLY_EXPECTED_PRESENT=
ATTENDANCE_MONTHLY_EXPECTED_HOURS=

# Fill only with exact data visible in Horilla after creating/verifying real fixtures.
ATTENDANCE_EMPLOYEE_NAME="Adam Admin"
ATTENDANCE_OTHER_EMPLOYEE_NAME="Emily Carter (NTI0001)"
ATTENDANCE_OVERNIGHT_RECORD_TEXT="2026-11-06"
ATTENDANCE_PENDING_RECORD_TEXT="No records available at the moment"
ATTENDANCE_OT_RECORD_TEXT="Ahmed Hassan (NTI0008)"
ATTENDANCE_REQUEST_DATE="2026-11-06"
ATTENDANCE_REQUEST_CHECK_IN="08:00"
ATTENDANCE_REQUEST_CHECK_OUT="17:00"
ATTENDANCE_CORRECTION_RECORD_TEXT="Adam Admin"
ATTENDANCE_CORRECTION_CHECK_IN="09:00:00"
ATTENDANCE_CORRECTION_CHECK_OUT="13:40:00"
ATTENDANCE_REQUEST_RECORD_TEXT="Do you want to approve this attendance request?"
ATTENDANCE_DAILY_STATUS_FIXTURE=
ATTENDANCE_CLOCK_TEST_USER=
ATTENDANCE_DUPLICATE_ACTION=
ATTENDANCE_LATE_RECORD_TEXT="Daniel Nguyen (NTI0002)"
ATTENDANCE_EARLY_RECORD_TEXT="Adam Admin"
ATTENDANCE_NEW_POLICY_NAME="AUTO_TC27_TimePolicy_20261106_1500"
ATTENDANCE_POLICY_NAME=
ATTENDANCE_POLICY_BOUNDARY_LABEL="Grace Time"
ATTENDANCE_POLICY_INVALID_VALUE=
ATTENDANCE_POLICY_VALID_VALUE=
ATTENDANCE_SESSION_ROLE=admin
